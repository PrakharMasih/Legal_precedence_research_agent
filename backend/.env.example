LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=
LLM_REQUEST_TIMEOUT=
LLM_MAX_RETRIES=

CORPUS_DIR=judgement_pdfs
SQLITE_DB_PATH=data/lexi.db

# Qdrant vector database
# Local development (embedded mode — no server needed):
#   leave QDRANT_URL unset; data is stored at QDRANT_PATH
# Docker Compose:
#   QDRANT_URL is set automatically by docker-compose.yml; do not set it here
# Qdrant Cloud:
#   set QDRANT_URL=https://<cluster>.qdrant.io and QDRANT_API_KEY=<key>
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=judgments
QDRANT_PATH=data/qdrant

LOG_LEVEL=INFO
LOG_FORMAT=json
HOST=0.0.0.0
PORT=8000

# Redis — set to enable caching (leave unset to disable gracefully)
REDIS_URL=redis://localhost:6379
